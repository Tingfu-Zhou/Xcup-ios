    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online Mode uses ReplayKit to capture screen and app audio. Microphone access is required, but microphone audio is not recorded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインモードで ReplayKit を使って画面とシステム音声を収録する際に、マイクの権限が必要です（取得するのはアプリの音声のみで、マイクの音声は録音しません）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "在线模式使用 ReplayKit 录制屏幕与系统音频时需要麦克风权限（仅采集应用音频，不录制麦克风）"
          }
        }
      }
    },
